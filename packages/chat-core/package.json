{
  "name": "@support-ai/chat-core",
  "version": "0.1.0",
  "description": "Framework-agnostic Support AI public chat client (HTTP + SSE)",
  "license": "MIT",
  "author": "Support AI Platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidhanshu/support-ai-platform.git",
    "directory": "packages/chat-core"
  },
  "homepage": "https://github.com/vidhanshu/support-ai-platform/tree/main/packages/chat-core",
  "bugs": {
    "url": "https://github.com/vidhanshu/support-ai-platform/issues"
  },
  "keywords": [
    "support-ai",
    "chat",
    "sse",
    "customer-support"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3"
  }
}
