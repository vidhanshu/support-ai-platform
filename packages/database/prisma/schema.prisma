generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum KnowledgeSourceType {
  DOCUMENT
  QNA
  WEBSITE
  NOTION
  TICKET
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships                WorkspaceMember[]
  refreshTokens              RefreshToken[]         @relation("UserRefreshTokens")
  invitations                WorkspaceInvitation[]
  agents                     Agent[]
  knowledgeSourceAttachments AgentKnowledgeSource[]

  @@index([email])
}

enum UploadStatus {
  UPLOADING
  COMPLETED
  FAILED
}

model RefreshToken {
  id String @id @default(uuid())

  userId    String
  tokenHash String
  expiresAt DateTime
  jti       String   @unique // token identifier for O(1) retrieval, we hash this in the refresh token

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id   String @id @default(uuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          WorkspaceMember[]
  agents           Agent[]
  knowledgeSources KnowledgeSource[]
  conversations    Conversation[]
  invitations      WorkspaceInvitation[]

  @@index([slug])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id    String        @id @default(uuid())
  email String
  role  WorkspaceRole
  token String        @unique

  expiresAt  DateTime
  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Agent {
  id           String   @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  systemPrompt String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  model        String?  @default("gpt-4.1-mini")
  temperature  Float?   @default(0.2)
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById  String

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  knowledgeSources AgentKnowledgeSource[]

  @@index([workspaceId])
  @@index([createdById])
}

// many-to-many relationship between Agents and KnowledgeSources
model AgentKnowledgeSource {
  id String @id @default(uuid())

  knowledgeSourceId String
  agentId           String

  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  attachedById String
  attachedBy   User   @relation(fields: [attachedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, knowledgeSourceId])
  @@index([agentId])
  @@index([knowledgeSourceId])
  @@index([attachedById])
}

model KnowledgeSource {
  id String @id @default(uuid())

  type   KnowledgeSourceType
  status KnowledgeSourceStatus @default(PENDING)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata  Json?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  agents   AgentKnowledgeSource[]
  document Document?

  // TODO: Add QnA and website support
  // qna QnA?
  // website Website?

  chunks Chunk[]

  @@index([workspaceId])
}

model Document {
  id               String       @id @default(uuid())
  originalFilename String
  objectKey        String       @unique
  mimeType         String
  size             Int
  uploadStatus     UploadStatus @default(UPLOADING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeSourceId String          @unique
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
}

model Chunk {
  id         String                     @id @default(uuid())
  text       String
  chunkIndex Int
  embedding  Unsupported("vector(768)")
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  tokenCount Int                        @default(0)
  metadata   Json?

  knowledgeSourceId String
  knowledgeSource   KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@index([knowledgeSourceId])
}

model Conversation {
  id          String   @id @default(uuid())
  workspaceId String
  agentId     String
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId])
  @@index([agentId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
